<?xml version="1.0" encoding="UTF-8" ?>
<routes xmlns="http://camel.apache.org/schema/spring" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://camel.apache.org/schema/spring ./../xsd/camel-spring.xsd">
    <route id="send-msg">
        <from uri="direct:send-msg"/>
        <log message="${body}"/>
        <setProperty name="person">
            <simple>${body}</simple>
        </setProperty>
        <bean beanType="java.util.Collections" method="singletonList"/>
        <bean ref="view" method="update('person', ${body})"/>
        <setBody>
            <simple>${exchangeProperty.person}</simple>
        </setBody>
    </route>

    <route id="get-ping-route">
        <from uri="direct:get-ping"/>
        <log message="${headers}"/>
        <setHeader name="Content-Type">
            <constant>application/json</constant>
        </setHeader>
        <setBody>
            <constant>{"msg":"HELLO"}</constant>
        </setBody>
    </route>

#if (${cxfSupport} == 'true')
    <route id="get-person-soap">
        <from uri="cxf:bean:cxfPayload"/>
        <convertBodyTo type="java.lang.String"/>
        <log message="${body}"/>
        <to uri="xslt:soap/get-person.xsl"/>
    </route>

#end

</routes>
